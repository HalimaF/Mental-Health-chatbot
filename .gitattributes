# Shell scripts and container files must keep LF endings. A CRLF in an
# entrypoint produces "exec format error" when the image runs on Linux.
*.sh            text eol=lf
Dockerfile      text eol=lf
Procfile        text eol=lf
docker-entrypoint.sh text eol=lf

# Normalise everything else to LF in the repository.
*.py            text eol=lf
*.html          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# Binary assets — never touch these.
*.png           binary
*.jpg           binary
*.svg           text eol=lf
*.db            binary
