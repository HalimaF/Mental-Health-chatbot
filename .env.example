# ---------------------------------------------------------------------------
# Dil-e-Azaad configuration. Copy to .env and fill in real values.
# Never commit the resulting .env file.
# ---------------------------------------------------------------------------

# --- Required in every environment -----------------------------------------

# Flask session signing key.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet key used to encrypt message content at rest. Losing this key means
# losing every stored conversation -- back it up somewhere durable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Hugging Face access token (read scope is enough).
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Database ---------------------------------------------------------------
# Defaults to a local SQLite file. Set a real Postgres URL in production:
# SQLite is fine for local dev but is wiped on every deploy on Render/Railway,
# because their filesystems are ephemeral.
DATABASE_URL=sqlite:///dil_azaad.db

# --- Model selection --------------------------------------------------------
# Any chat-completion capable model served by HF Inference Providers.
HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Optional: pin a specific inference provider (together, fireworks-ai, hf-inference...)
HF_PROVIDER=

# Safety and affect classifiers (text-classification endpoints).
HF_SUICIDE_MODEL=vibhorag101/roberta-base-suicide-prediction-phr
HF_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# --- Generation tuning ------------------------------------------------------
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=25

# --- Conversation memory ----------------------------------------------------
# Turns kept verbatim in the prompt before older turns are rolled into a summary.
MEMORY_TURN_WINDOW=12
MEMORY_SUMMARY_TRIGGER=20

# --- Operational ------------------------------------------------------------
FLASK_ENV=development
LOG_LEVEL=INFO

# Rate limit backend. Leave blank to use in-process memory (single worker only).
# Set a redis:// URL when running more than one gunicorn worker.
RATELIMIT_STORAGE_URI=

# Set to 1 only when serving over HTTPS (production).
SESSION_COOKIE_SECURE=0
